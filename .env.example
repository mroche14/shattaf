# ===========================================
# Shattaf Marketplace - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Application
APP_NAME="Shattaf Marketplace API"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shattaf

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated for multiple origins)
CORS_ORIGINS=["http://localhost:3003","http://localhost:3001","http://localhost:3002","http://localhost:5173","http://localhost:5174"]

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PLATFORM_FEE_PERCENT=15.0

# Google Maps (https://console.cloud.google.com/apis/credentials)
GOOGLE_MAPS_API_KEY=AIza...

# Brevo / Sendinblue (https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=noreply@oasis-shattaf.com
BREVO_SENDER_NAME=Oasis Shattaf

# S3/Cloudflare R2 Storage
S3_ENDPOINT_URL=https://xxx.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=shattaf-uploads
S3_PUBLIC_URL=https://uploads.oasis-shattaf.com

# Service Zone (Guadeloupe default)
SERVICE_ZONE_POSTAL_PREFIX=971
SERVICE_ZONE_COORDS_CENTER=(16.265, -61.551)
SERVICE_ZONE_RADIUS_KM=100.0
