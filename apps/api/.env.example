# Shattaf API - Environment Variables
# Copy to .env and configure

# Application
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shattaf

# JWT
JWT_SECRET_KEY=change-this-to-a-secure-random-string

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Maps
GOOGLE_MAPS_API_KEY=

# Brevo
BREVO_API_KEY=

# S3/R2
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=shattaf-uploads
