{
  "name": "@shattaf/api-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "generate": "openapi-typescript http://localhost:8010/openapi.json -o src/schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shattaf/shared-types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "openapi-typescript": "^7.4.0"
  }
}
